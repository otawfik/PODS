rules_version = '2';

// PODS Firestore security rules.
// Deploy with: firebase deploy --only firestore:rules
// (requires Firebase CLI login; see firebase.json)
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function signedInUniversity() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('university', '');
    }

    function podMembers(podId) {
      return get(/databases/$(database)/documents/pods/$(podId)).data.get('members', []);
    }

    function podAdmins(podId) {
      return get(/databases/$(database)/documents/pods/$(podId)).data.get('admins', []);
    }

    // ---------- users ----------
    match /users/{uid} {
      // Any signed-in user can read profiles (needed for member lists, names).
      allow read: if isSignedIn();
      // Users can only create/update their own document.
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---------- pods ----------
    match /pods/{podId} {
      allow read: if isSignedIn() && (
        resource.data.get('visibility', 'public') == 'public' ||
        request.auth.uid in resource.data.get('members', [])
      );
      allow create: if isSignedIn()
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.auth.uid in request.resource.data.get('members', [])
        && request.auth.uid in request.resource.data.get('admins', []);
      allow update: if isSignedIn() && (
        // Pod admins can update anything.
        request.auth.uid in resource.data.get('admins', []) ||
        // Everyone else may only join/leave: the members diff must be
        // limited to themselves, and only members/memberCount may change.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount'])
          && request.resource.data.get('members', []).toSet()
               .difference(resource.data.get('members', []).toSet()).hasOnly([request.auth.uid])
          && resource.data.get('members', []).toSet()
               .difference(request.resource.data.get('members', []).toSet()).hasOnly([request.auth.uid])
        )
      );
      allow delete: if isSignedIn() && request.auth.uid in resource.data.get('admins', []);
    }

    // ---------- pod invite codes ----------
    // Maps inviteCode -> { podId }. Readable so "join with code" works without
    // exposing private pod documents. Codes are unguessable; knowing a code
    // is the authorization to join.
    match /podInvites/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid in
        podAdmins(resource.data.get('podId', ''));
    }

    // ---------- activities ----------
    match /activities/{activityId} {
      allow read: if isSignedIn() && (
        request.auth.uid in
          get(/databases/$(database)/documents/pods/$(resource.data.get('podId', ''))).data.get('members', [])
        ||
        (
          resource.data.get('visibility', 'pod') == 'university'
          && resource.data.get('university', '') == signedInUniversity()
          && signedInUniversity() != ''
        )
      );
      allow create: if isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/pods/$(request.resource.data.get('podId', ''))).data.get('members', [])
        && request.resource.data.get('hostId', '') == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.get('hostId', '')
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['participants', 'pendingRequests', 'currentParticipants', 'status'])
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.get('hostId', '')
        || request.auth.uid in
          get(/databases/$(database)/documents/pods/$(resource.data.get('podId', ''))).data.get('admins', [])
      );
    }

    // ---------- messages (activity + pod chat) ----------
    match /messages/{messageId} {
      function activityParticipants(actId) {
        return get(/databases/$(database)/documents/activities/$(actId)).data.get('participants', []);
      }
      allow read: if isSignedIn() && (
        (
          resource.data.get('activityId', null) != null
          && request.auth.uid in activityParticipants(resource.data.get('activityId', ''))
        ) || (
          resource.data.get('podId', null) != null
          && request.auth.uid in podMembers(resource.data.get('podId', ''))
        )
      );
      allow create: if isSignedIn()
        && request.resource.data.get('senderId', '') == request.auth.uid
        && (
          (
            request.resource.data.get('activityId', null) != null
            && request.auth.uid in activityParticipants(request.resource.data.get('activityId', ''))
          ) || (
            request.resource.data.get('podId', null) != null
            && request.auth.uid in podMembers(request.resource.data.get('podId', ''))
          )
        );
      allow update: if false;
      allow delete: if isSignedIn() && (
        (
          resource.data.get('activityId', null) != null
          && request.auth.uid ==
            get(/databases/$(database)/documents/activities/$(resource.data.get('activityId', ''))).data.get('hostId', '')
        ) || (
          resource.data.get('podId', null) != null
          && request.auth.uid in podAdmins(resource.data.get('podId', ''))
        )
      );
    }
  }
}
