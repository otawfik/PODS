{
  "name": "pods",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "eval:recs": "tsx scripts/eval-recommendations.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.7",
    "@react-navigation/native": "^7.2.0",
    "@react-navigation/native-stack": "^7.14.8",
    "@supabase/supabase-js": "^2.117.3",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.20",
    "expo-modules-core": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "jest-expo": "~57.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "private": true,
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@electric-sql/pglite": "^0.5.16",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/supabase/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 20000
  }
}
